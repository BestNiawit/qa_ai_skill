# ── OS ─────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── Editor / IDE ───────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# ── Secrets (ห้ามขึ้น git เด็ดขาด) ─────────────────
.env
.env.*
!.env.example

# ── Claude config ──────────────────────────────────
# ignore everything under .claude/ (per-machine state, history, etc.)
.claude/*
# ... except team-shared settings.json (marketplace declaration for zero-script install)
!.claude/settings.json

# ── Logs / Temp / Cache ────────────────────────────
*.log
*.tmp
tmp/
.cache/

# ── Python (เผื่อ skill gen Python) ────────────────
__pycache__/
*.pyc
*.pyo

# ── Node (เผื่อใครใช้) ─────────────────────────────
node_modules/

# ── Typst test/scratch files (ขึ้นต้นด้วย _) ──────
_*.typ
_*.pdf

# ── AI-generated workspace (per-user, ไม่ใช่ artifact ของ repo) ──
outputs

# ── User-supplied raw run data per skill (k6 results, Jira exports, etc.) ──
skills/*/input/

# ── Sample packs: ignore ทุกไฟล์ใน docs/samples/<pack>/ ยกเว้น README.md (pointer doc) ──
docs/samples/*/*
!docs/samples/*/README.md

# ── Excel exports (Jira / test data ที่อาจมี PII) ──
*.xlsx
